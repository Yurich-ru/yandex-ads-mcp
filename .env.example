# Yandex Direct API (required)
# Get OAuth token: https://oauth.yandex.ru/authorize?response_type=token&client_id=YOUR_CLIENT_ID
# Required scopes: direct:api (+ metrika:read/metrika:write for Metrika,
# Yandex Audience access for yd_audience_* tools, cloud:auth for Wordstat)
YD_OAUTH_TOKEN=y0_YOUR_TOKEN_HERE

# Yandex Cloud (required for Wordstat API)
# Get folder ID from https://console.yandex.cloud/
# Required: billing account + role search-api.executor on folder
# OAuth token must have scope cloud:auth
YC_FOLDER_ID=YOUR_FOLDER_ID_HERE

# Optional
YD_SANDBOX=false
YD_LOGIN=

# ── Multi-account tokens ───────────────────────────────────────────────
# If Direct lives in one Yandex account and Metrika/Audience in another,
# set per-service tokens here. Empty = fall back to YD_OAUTH_TOKEN.
YD_METRIKA_TOKEN=
YD_AUDIENCE_TOKEN=
# Extra Direct cabinets (non-agency): login:token pairs, comma-separated.
# Pick one per call with the client_login argument; such logins use their own
# token and no Client-Login header. Empty = single cabinet (YD_OAUTH_TOKEN).
YD_DIRECT_TOKENS=

# Service-account API key for Wordstat (role search-api.executor on the folder).
# REQUIRED for OAuth tokens issued after 2026-06-01: Yandex Cloud no longer
# exchanges them for IAM tokens. Empty = legacy OAuth→IAM exchange.
YC_API_KEY=

# ── Safety / access control ────────────────────────────────────────────
# Block every mutating tool (add/update/delete/action/set/...). Reports & reads still work.
YD_READONLY=false
# Require confirm=true on every mutating tool; otherwise the call returns a preview only.
YD_CONFIRM=false
# Whitelist of allowed agency Client-Logins (comma-separated). Empty = no restriction.
# Applies to Yandex Direct tools; per-call override via the client_login argument.
YD_ALLOWED_LOGINS=

# ── Logging ────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR (default INFO).
YD_LOG_LEVEL=INFO
# Path to a log file. Empty = stderr only, no file on disk (previous builds always wrote one).
YD_LOG_FILE=
# Dump full request/response bodies to the log (verbose; may contain ad/campaign data).
YD_LOG_BODIES=false
